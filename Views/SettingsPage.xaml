<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Traymote.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="16,12,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                Width="36"
                Height="36"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Settings" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <Grid
                    Padding="16,12"
                    VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ColumnSpacing="12"
                    CornerRadius="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" />
                        <TextBlock
                            x:Name="StartupDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Keep the remote ready after you sign in."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Start with Windows"
                        IsEnabled="False"
                        OffContent=""
                        OnContent=""
                        Toggled="StartupToggle_Toggled" />
                </Grid>
                <StackPanel
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="HotKeyLabel"
                            x:Uid="HotKeyLabel"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            x:Name="HotKeyToggle"
                            AutomationProperties.AutomationId="HotKeyToggle"
                            AutomationProperties.LabeledBy="{x:Bind HotKeyLabel}"
                            Grid.Column="1"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="HotKeyToggle_Toggled" />
                    </Grid>
                    <TextBlock
                        x:Name="HotKeyDescription"
                        AutomationProperties.AutomationId="HotKeyDescription"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="HotKeyButton"
                        x:Uid="HotKeyButton"
                        AutomationProperties.AutomationId="HotKeyButton"
                        HorizontalAlignment="Stretch"
                        Click="HotKeyButton_Click"
                        LostFocus="HotKeyButton_LostFocus"
                        PreviewKeyDown="HotKeyButton_PreviewKeyDown" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            x:Name="VersionText"
            Grid.Row="2"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
</Page>
